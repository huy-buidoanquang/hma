<Application x:Class="Hma.Desktop.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Hma.Desktop.Wpf.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Infrastructure/Theming/Colors.Palette.xaml"/>
                <ResourceDictionary Source="Infrastructure/Theming/Colors.Light.xaml"/>
                <ResourceDictionary Source="Infrastructure/Theming/Typography.xaml"/>
                <ResourceDictionary Source="Infrastructure/Theming/Buttons.xaml"/>
                <ResourceDictionary Source="Infrastructure/Theming/Controls.xaml"/>
                <ResourceDictionary Source="Infrastructure/Theming/Fields.xaml"/>
                <ResourceDictionary Source="Infrastructure/Theming/ScrollBars.xaml"/>
                <ResourceDictionary Source="Infrastructure/Theming/Layouts.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>
            <conv:VndMoneyConverter x:Key="VndMoney"/>
            <conv:LocationAliasKindConverter x:Key="LocationAliasKind"/>
            <conv:BusinessEnumLabelConverter x:Key="BusinessEnumLabel"/>
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            </Style>
            <Style TargetType="UserControl">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
