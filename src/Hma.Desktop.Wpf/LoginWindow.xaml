<Window x:Class="Hma.Desktop.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hà Minh Anh"
        Height="420" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Margin="0"
        Padding="0"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource InkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource BrushDeep}">
            <StackPanel VerticalAlignment="Center" Margin="36,0">
                <TextBlock Text="HÀ MINH ANH" FontSize="32" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushOnBrand}"/>
                <TextBlock Text="Điều hành xe · vận tải" FontSize="16"
                           Foreground="{DynamicResource BrushOnBrand}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="36,18">
            <Label Content="Tên đăng nhập"/>
            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="Mật khẩu"/>
            <PasswordBox x:Name="PasswordBox"/>
            <Button Content="Đăng nhập" Click="OnLoginClick" HorizontalAlignment="Left" MinWidth="140" Margin="0,8,0,0"/>
            <TextBlock Text="Mặc định: admin / admin123" Style="{StaticResource CaptionText}" Margin="0,16,0,0"/>
        </StackPanel>
        <Border Grid.RowSpan="2" Panel.ZIndex="20"
                Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ToastBanner}">
                    <Setter Property="Background" Value="{DynamicResource BrushError}"/>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource BrushOnBrand}"
                       TextWrapping="Wrap" FontSize="13"/>
        </Border>
    </Grid>
</Window>
