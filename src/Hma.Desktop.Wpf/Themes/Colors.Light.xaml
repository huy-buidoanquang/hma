<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.Palette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource Gray050}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource Gray950}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Gray025}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource Gray950}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource Gray500}"/>

    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource Gray050}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Gray025}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="NavBrush" Color="{StaticResource Blue900}"/>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Gray950}"/>
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="InkMutedBrush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="NavTextBrush" Color="{StaticResource Gray050}"/>

    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource Blue200}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Blue500}"/>
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource Blue900}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Blue50}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Green700}"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource Green50}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Orange600}"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource Orange50}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Red700}"/>
    <SolidColorBrush x:Key="ErrorBgBrush" Color="{StaticResource Red50}"/>

    <SolidColorBrush x:Key="BrushOverlayMask" Color="{StaticResource Blue900}" Opacity="0.24"/>

    <SolidColorBrush x:Key="BrushPage" Color="{StaticResource Gray050}"/>
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource Gray025}"/>
    <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="BrushInk" Color="{StaticResource Gray950}"/>
    <SolidColorBrush x:Key="BrushOnBrand" Color="{StaticResource Gray050}"/>
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource Blue500}"/>
    <SolidColorBrush x:Key="BrushDeep" Color="{StaticResource Blue900}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource Red700}"/>
    <SolidColorBrush x:Key="BrushErrorBg" Color="{StaticResource Red50}"/>
    <SolidColorBrush x:Key="BrushWhite" Color="{StaticResource Gray025}"/>
    <SolidColorBrush x:Key="BrushBlack" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
