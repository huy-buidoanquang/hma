<UserControl x:Class="Hma.Desktop.Wpf.Views.PriceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Hma.Desktop.Wpf.Behaviors">
    <Grid>
        <DockPanel Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibility}}" Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Bảng giá" Style="{StaticResource WorkspaceTitle}" Margin="0,0,0,16"/>
            <WrapPanel DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
                <Button Content="Thêm mới" Command="{Binding NewItemCommand}" IsEnabled="{Binding CanCreate}"/>
            </WrapPanel>
            <Border Style="{StaticResource StatusBanner}" DockPanel.Dock="Bottom"
                    Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrushBlack}"/>
            </Border>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                      b:CommandBehaviors.DoubleClickCommand="{Binding ViewItemCommand}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="80"/>
                    <DataGridTextColumn Header="Tên bảng giá" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding Customer.Name}" Width="140"/>
                    <DataGridTextColumn Header="Hiệu lực từ" Binding="{Binding EffectiveFrom, StringFormat=dd/MM/yyyy}" Width="90"/>
                    <DataGridTextColumn Header="Đến" Binding="{Binding EffectiveTo, StringFormat=dd/MM/yyyy}" Width="90"/>
                    <DataGridTemplateColumn Header="Khóa" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource GridCheckBox}"
                                          IsChecked="{Binding IsLocked}"
                                          IsEnabled="False"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="{Binding EditorTitle}" Style="{StaticResource WorkspaceTitle}" Margin="0,0,0,16"/>
            <WrapPanel DockPanel.Dock="Bottom" Style="{StaticResource ToolbarPanel}">
                <Button Content="Lưu bảng giá" Command="{Binding SaveListCommand}" IsEnabled="{Binding CanSave}"/>
                <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
                <Button Content="Khóa" Style="{StaticResource SecondaryButton}" Command="{Binding LockListCommand}" IsEnabled="{Binding CanUpdate}"/>
            </WrapPanel>
            <Border Style="{StaticResource StatusBanner}" DockPanel.Dock="Bottom"
                    Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrushBlack}"/>
            </Border>
            <ScrollViewer b:ScrollViewerBehaviors.FormScroll="True" IsEnabled="{Binding AreFieldsEnabled}">
                <StackPanel>
                    <Border Style="{StaticResource EditorCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Style="{StaticResource FormLabel}" Content="Mã"/>
                                <TextBox Grid.Column="1" Margin="0" Text="{Binding Editor.Code, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Required" IsReadOnly="{Binding IsEditorReadOnly}"/>
                            </Grid>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Style="{StaticResource FormLabel}" Content="Tên"/>
                                <TextBox Grid.Column="1" Margin="0" Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Required" IsReadOnly="{Binding IsEditorReadOnly}"/>
                            </Grid>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Style="{StaticResource FormLabel}" Content="Khách (trống = giá công bố)"/>
                                <ComboBox Grid.Column="1" Margin="0" ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Editor.CustomerId}" IsEnabled="{Binding AreFieldsEnabled}"/>
                            </Grid>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Style="{StaticResource FormLabel}" Content="Hiệu lực từ"/>
                                <DatePicker Grid.Column="1" Margin="0" SelectedDate="{Binding Editor.EffectiveFrom}" IsEnabled="{Binding AreFieldsEnabled}"/>
                            </Grid>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Style="{StaticResource FormLabel}" Content="Hiệu lực đến"/>
                                <DatePicker Grid.Column="1" Margin="0" SelectedDate="{Binding Editor.EffectiveTo}" IsEnabled="{Binding AreFieldsEnabled}"/>
                            </Grid>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Style="{StaticResource FormLabel}" Content="Biến động giá"/>
                                <CheckBox Grid.Column="1" Margin="0" VerticalAlignment="Center"
                                          IsChecked="{Binding Editor.HasPriceFluctuation}"
                                          Content="Bảng có biến động giá"
                                          IsEnabled="{Binding AreFieldsEnabled}"/>
                            </Grid>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Style="{StaticResource FormLabel}" Content="Lý do khóa"/>
                                <TextBox Grid.Column="1" Margin="0" Text="{Binding Editor.LockReason}" IsReadOnly="{Binding IsEditorReadOnly}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Dòng giá: tuyến × loại xe" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                    <WrapPanel Style="{StaticResource ToolbarPanel}">
                        <StackPanel Style="{StaticResource FilterCluster}">
                            <Label Style="{StaticResource FilterLabel}" Content="Tuyến"/>
                            <ComboBox Style="{StaticResource FilterCombo}" Width="220" ItemsSource="{Binding Routes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedRouteId}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FilterCluster}">
                            <Label Style="{StaticResource FilterLabel}" Content="Loại xe"/>
                            <ComboBox Style="{StaticResource FilterCombo}" Width="140" ItemsSource="{Binding VehicleTypes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedVehicleTypeId}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FilterCluster}">
                            <Label Style="{StaticResource FilterLabel}" Content="Đơn giá"/>
                            <TextBox Style="{StaticResource FilterMoney}" Text="{Binding UnitPrice, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FilterCluster}">
                            <Label Style="{StaticResource FilterLabel}" Content="Phụ phí"/>
                            <TextBox Style="{StaticResource FilterMoney}" Text="{Binding Surcharge, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money"/>
                        </StackPanel>
                        <Button Content="Thêm cước" Style="{StaticResource SecondaryButton}" Command="{Binding AddRateCommand}" IsEnabled="{Binding CanUpdate}" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
                        <Button Content="Xóa dòng" Style="{StaticResource DestructiveButton}" Command="{Binding DeleteRateCommand}" IsEnabled="{Binding CanDelete}" VerticalAlignment="Bottom" Margin="16,0,0,8"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding RevisionItems}" SelectedItem="{Binding SelectedItem}" MinHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tuyến" Binding="{Binding Route.Name}" Width="*"/>
                            <DataGridTextColumn Header="Loại xe" Binding="{Binding VehicleType.Name}" Width="*"/>
                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, Converter={StaticResource VndMoney}}" Width="110" ElementStyle="{StaticResource TabularMoneyCell}"/>
                            <DataGridTextColumn Header="Phụ phí" Binding="{Binding Surcharge, Converter={StaticResource VndMoney}}" Width="110" ElementStyle="{StaticResource TabularMoneyCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
