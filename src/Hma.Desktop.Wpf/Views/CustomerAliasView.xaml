<UserControl x:Class="Hma.Desktop.Wpf.Views.CustomerAliasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Hma.Desktop.Wpf.Behaviors"
             xmlns:controls="clr-namespace:Hma.Desktop.Wpf.Controls">
    <Grid>
        <DockPanel Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Từ điển khách hàng" Style="{StaticResource WorkspaceTitle}" Margin="0,0,0,8"/>
            <TextBlock DockPanel.Dock="Top" Text="Bí danh (TEC, KMG, glovis) trỏ tới mã khách hàng catalog."
                       TextWrapping="Wrap" Margin="0,0,0,16" Opacity="0.75"/>
            <StackPanel DockPanel.Dock="Top">
                <WrapPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Bí danh / mã / tên"/>
                        <TextBox Style="{StaticResource FilterField}" Width="220" Text="{Binding FilterText}"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel Style="{StaticResource ActionBar}">
                    <Button Content="Tìm" Command="{Binding SearchCommand}"/>
                    <Button Content="Làm lại" Style="{StaticResource SecondaryButton}" Command="{Binding ResetFiltersCommand}"/>
                    <Border Style="{StaticResource ToolbarSpacer}"/>
                    <Button Content="Thêm mới" Command="{Binding NewItemCommand}" IsEnabled="{Binding CanCreate}"/>
                </WrapPanel>
            </StackPanel>
            <Border DockPanel.Dock="Bottom"
                    Visibility="{Binding ToastMessage, Converter={StaticResource StringToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatusBanner}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushError}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource BrushBlack}"/>
            </Border>
            <Border Style="{StaticResource StatusBanner}" DockPanel.Dock="Bottom"
                    Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrushBlack}"/>
            </Border>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                      b:CommandBehaviors.DoubleClickCommand="{Binding ViewItemCommand}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bí danh" Binding="{Binding Alias}" Width="140"/>
                    <DataGridTextColumn Header="Mã KH" Binding="{Binding Customer.Code}" Width="100"/>
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding Customer.Name}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <controls:EditorOverlay Visibility="{Binding IsBrowsing, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <StackPanel IsEnabled="{Binding AreFieldsEnabled}">
                <Grid Style="{StaticResource FormRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource FormLabel}" Content="Bí danh"/>
                    <TextBox Grid.Column="1" Margin="0" Text="{Binding Editor.Alias, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Required"/>
                </Grid>
                <Grid Style="{StaticResource FormRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource FormLabel}" Content="Khách hàng"/>
                    <ComboBox Grid.Column="1" Margin="0" ItemsSource="{Binding Customers}" DisplayMemberPath="CodeName"
                              SelectedValuePath="Id" SelectedValue="{Binding Editor.CustomerId}"/>
                </Grid>
                </StackPanel>
                <StackPanel Style="{StaticResource EditorActions}">
                    <Button Content="Lưu" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"/>
                    <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
                    <Button Content="Xóa" Style="{StaticResource DestructiveButton}" Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding CanDelete}" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </StackPanel>
        </controls:EditorOverlay>
    </Grid>
</UserControl>
