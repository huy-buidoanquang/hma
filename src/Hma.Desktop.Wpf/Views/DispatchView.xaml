<UserControl x:Class="Hma.Desktop.Wpf.Views.DispatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Hma.Desktop.Wpf.Behaviors"
             xmlns:controls="clr-namespace:Hma.Desktop.Wpf.Controls">
    <Grid>
        <DockPanel Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibility}}" Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Lệnh điều xe" Style="{StaticResource WorkspaceTitle}" Margin="0,0,0,16"/>
            <StackPanel DockPanel.Dock="Top">
                <WrapPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Số LDX"/>
                        <TextBox Style="{StaticResource FilterField}" Width="112" Text="{Binding FilterCode}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Mã KH"/>
                        <TextBox Style="{StaticResource FilterField}" Width="100" Text="{Binding FilterCustomerCode}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Từ ngày"/>
                        <DatePicker Style="{StaticResource FilterDate}" SelectedDate="{Binding FilterFrom}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Đến ngày"/>
                        <DatePicker Style="{StaticResource FilterDate}" SelectedDate="{Binding FilterTo}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Khách hàng"/>
                        <ComboBox Style="{StaticResource FilterCombo}" Width="200" ItemsSource="{Binding CustomerOptions}" DisplayMemberPath="CodeName" SelectedValuePath="Id" SelectedValue="{Binding FilterCustomerId}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Biển số"/>
                        <TextBox Style="{StaticResource FilterField}" Width="112" Text="{Binding FilterPlate}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Điểm đi"/>
                        <ComboBox Style="{StaticResource FilterCombo}" Width="140" ItemsSource="{Binding Locations}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FilterPickupLocationId}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Điểm đến"/>
                        <ComboBox Style="{StaticResource FilterCombo}" Width="140" ItemsSource="{Binding Locations}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FilterDeliveryLocationId}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Trọng tải"/>
                        <TextBox Style="{StaticResource FilterField}" Width="80" Text="{Binding FilterTonnage, TargetNullValue=''}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Loại xe"/>
                        <ComboBox Style="{StaticResource FilterCombo}" Width="140" ItemsSource="{Binding VehicleTypes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FilterVehicleTypeId}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Trạng thái"/>
                        <ComboBox Style="{StaticResource FilterCombo}" Width="140" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding FilterStatus}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Đối soát"/>
                        <ComboBox Style="{StaticResource FilterCombo}" Width="160" ItemsSource="{Binding ReconOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding FilterRecon}"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel Style="{StaticResource ActionBar}">
                    <Button Content="Tìm" Command="{Binding SearchCommand}"/>
                    <Button Content="Làm lại" Style="{StaticResource SecondaryButton}" Command="{Binding ResetFiltersCommand}"/>
                    <Border Style="{StaticResource ToolbarSpacer}"/>
                    <Button Content="Thêm mới" Command="{Binding NewItemCommand}" IsEnabled="{Binding CanCreate}"/>
                    <Button Content="Excel cước" Style="{StaticResource SecondaryButton}" Command="{Binding ExportExcelCommand}" IsEnabled="{Binding CanPrint}"/>
                    <Button Content="In ngày" Style="{StaticResource SecondaryButton}" Command="{Binding PrintSummaryDayCommand}" IsEnabled="{Binding CanPrint}"/>
                    <Button Content="In tháng" Style="{StaticResource SecondaryButton}" Command="{Binding PrintSummaryMonthCommand}" IsEnabled="{Binding CanPrint}"/>
                    <Button Content="In theo khách" Style="{StaticResource SecondaryButton}" Command="{Binding PrintSummaryCustomerCommand}" IsEnabled="{Binding CanPrint}"/>
                </WrapPanel>
            </StackPanel>
            <Border Style="{StaticResource StatusBanner}" DockPanel.Dock="Bottom"
                    Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrushBlack}"/>
            </Border>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                      b:CommandBehaviors.DoubleClickCommand="{Binding ViewItemCommand}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ngày chạy" Binding="{Binding PickupAt, StringFormat=dd/MM/yyyy}" Width="90"/>
                    <DataGridTextColumn Header="Số LDX" Binding="{Binding Code}" Width="80"/>
                    <DataGridTemplateColumn Header="Trạng thái" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:StatusBadge OrderStatus="{Binding Status}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Đối soát" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:StatusBadge ReconStatus="{Binding ReconciliationStatus}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Mã KH" Binding="{Binding Customer.Code}" Width="80"/>
                    <DataGridTextColumn Header="Tuyến" Binding="{Binding RouteLabel}" Width="160"/>
                    <DataGridTextColumn Header="Biển" Binding="{Binding Vehicle.PlateNumber}" Width="90" ElementStyle="{StaticResource TabularCell}"/>
                    <DataGridTextColumn Header="Tải" Binding="{Binding VehicleType.Name}" Width="80"/>
                    <DataGridTextColumn Header="Cước" Binding="{Binding UnitPrice, Converter={StaticResource VndMoney}}" Width="90" ElementStyle="{StaticResource TabularMoneyCell}"/>
                    <DataGridTextColumn Header="Phát sinh" Binding="{Binding ExtraCost, Converter={StaticResource VndMoney}}" Width="80" ElementStyle="{StaticResource TabularMoneyCell}"/>
                    <DataGridTextColumn Header="TT" Binding="{Binding PaymentMethod.Name}" Width="90"/>
                    <DataGridTextColumn Header="Kỳ KT" Binding="{Binding BillingMonth, StringFormat={}{0:00}}" Width="40"/>
                    <DataGridTextColumn Header="Khách" Binding="{Binding Customer.Name}" MinWidth="80" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" Margin="16">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16" LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <controls:StatusBadge OrderStatus="{Binding Editor.Status}" Margin="0,0,8,0"/>
                    <controls:StatusBadge ReconStatus="{Binding Editor.ReconciliationStatus}"/>
                </StackPanel>
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource WorkspaceTitle}"/>
            </DockPanel>
            <WrapPanel DockPanel.Dock="Bottom" Style="{StaticResource ToolbarPanel}">
                <Button Content="Tính cước" Style="{StaticResource SecondaryButton}" Command="{Binding CalcFreightCommand}" IsEnabled="{Binding AreFieldsEnabled}"/>
                <Button Content="Lưu" Command="{Binding SaveCommand}" IsEnabled="{Binding CanPersist}"/>
                <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
                <Button Content="Hoàn thành" Style="{StaticResource SecondaryButton}" Command="{Binding CompleteCommand}" IsEnabled="{Binding CanUpdate}"/>
                <Button Content="Chốt lệnh" Style="{StaticResource SecondaryButton}" Command="{Binding LockCommand}" IsEnabled="{Binding CanLock}"/>
                <Button Content="Bỏ chốt" Style="{StaticResource SecondaryButton}" Command="{Binding UnlockCommand}" IsEnabled="{Binding CanUnlock}"/>
                <Button Content="In lệnh" Style="{StaticResource SecondaryButton}" Command="{Binding PrintCommand}" IsEnabled="{Binding CanPrint}"/>
                <Button Content="Xóa" Style="{StaticResource DestructiveButton}" Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding CanDelete}" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}"/>
            </WrapPanel>
            <Border Style="{StaticResource StatusBanner}" DockPanel.Dock="Bottom"
                    Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrushBlack}"/>
            </Border>
            <ScrollViewer b:ScrollViewerBehaviors.FormScroll="True" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource EditorCard}" IsEnabled="{Binding AreFieldsEnabled}">
                    <StackPanel>
                        <WrapPanel>
                            <StackPanel Width="140" Margin="0,0,8,8"><Label Content="Số lệnh"/><TextBox Text="{Binding CodeLabel, Mode=OneWay}" IsReadOnly="True"/></StackPanel>
                            <StackPanel Width="160" Margin="0,0,8,8"><Label Content="Ngày chạy"/><DatePicker SelectedDate="{Binding PickupDate}" IsEnabled="{Binding AreFieldsEnabled}"/></StackPanel>
                            <StackPanel Width="260" Margin="0,0,8,8"><Label Content="Khách hàng (mã)"/><ComboBox ItemsSource="{Binding CustomerOptions}" DisplayMemberPath="CodeName" SelectedValuePath="Id" SelectedValue="{Binding EditorCustomerId}" IsEnabled="{Binding AreFieldsEnabled}"/></StackPanel>
                            <StackPanel Width="260" Margin="0,0,8,8"><Label Content="Tuyến"/><ComboBox ItemsSource="{Binding Routes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EditorRouteId}" IsEnabled="{Binding AreFieldsEnabled}"/></StackPanel>
                            <StackPanel Width="140" Margin="0,0,8,8"><Label Content="Biển kiểm soát"/><ComboBox ItemsSource="{Binding Vehicles}" DisplayMemberPath="PlateNumber" SelectedValuePath="Id" SelectedValue="{Binding EditorVehicleId}" IsEnabled="{Binding AreFieldsEnabled}"/></StackPanel>
                            <StackPanel Width="120" Margin="0,0,8,8"><Label Content="Trọng tải"/><TextBox Text="{Binding TonnageLabel, Mode=OneWay}" IsReadOnly="True"/></StackPanel>
                            <StackPanel Width="200" Margin="0,0,8,8"><Label Content="Tài xế"/><ComboBox ItemsSource="{Binding Drivers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EditorDriverId}" IsEnabled="{Binding AreFieldsEnabled}"/></StackPanel>
                            <StackPanel Width="160" Margin="0,0,8,8"><Label Content="Hình thức thanh toán"/><ComboBox ItemsSource="{Binding PaymentMethods}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EditorPaymentMethodId}" IsEnabled="{Binding AreFieldsEnabled}"/></StackPanel>
                            <StackPanel Width="160" Margin="0,0,8,8"><Label Content="Kỳ kế toán"/><controls:MonthYearPicker Month="{Binding Editor.BillingMonth}" Year="{Binding Editor.BillingYear}" IsEnabled="{Binding AreFieldsEnabled}"/></StackPanel>
                            <StackPanel Width="140" Margin="0,0,8,8"><Label Content="Số AR"/><TextBox Text="{Binding Editor.ArNumber}" IsEnabled="{Binding AreFieldsEnabled}"/></StackPanel>
                        </WrapPanel>
                        <WrapPanel>
                            <StackPanel Width="168" Margin="0,0,12,8"><Label Content="Cước"/><TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.UnitPrice, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money" IsReadOnly="{Binding IsFreightReadOnly}"/></StackPanel>
                            <StackPanel Width="168" Margin="0,0,12,8"><Label Content="Phụ phí"/><TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.Surcharge, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money" IsReadOnly="{Binding IsFreightReadOnly}"/></StackPanel>
                            <StackPanel Width="168" Margin="0,0,12,8"><Label Content="Phát sinh"/><TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.ExtraCost, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money" IsReadOnly="{Binding IsFreightReadOnly}"/></StackPanel>
                            <StackPanel Width="168" Margin="0,0,12,8"><Label Content="Tổng"/><TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.TotalAmount, Converter={StaticResource VndMoney}, Mode=OneWay}" IsReadOnly="True"/></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding FreightSourceLabel}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource InkSecondaryBrush}"/>
                        <TextBlock Text="Chưa khớp bảng giá — nhập cước thủ công hoặc bổ sung dòng giá (tuyến × loại xe)."
                                   TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource BrushError}"
                                   Visibility="{Binding FreightMissing, Converter={StaticResource BoolToVisibility}}"/>
                        <Label Content="Ghi chú"/><TextBox Text="{Binding Editor.Notes}" IsReadOnly="{Binding IsEditorReadOnly}"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
