<UserControl x:Class="Hma.Desktop.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Hma.Desktop.Wpf.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Cấu hình" Style="{StaticResource WorkspaceTitle}" Margin="16,24,16,16"/>
                <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                         Background="Transparent" BorderThickness="0" Margin="8,0,8,16"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource HubNavListBoxItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontSize="15"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <ScrollViewer Margin="16" Visibility="{Binding IsParametersSelected, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource EditorCard}" MaxWidth="520" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Tham số hệ thống" Style="{StaticResource WorkspaceTitle}" Margin="0,0,0,16"/>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Giao diện"/>
                            <ComboBox Grid.Column="1" Margin="0" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding UiTheme, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="VAT (%)"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding VatRate}"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Thư mục lưu chứng từ"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding DocumentStorePath}"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Số đếm lệnh điều xe"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding DispatchOrderLastValue}"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Số đếm bảng kê"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding FreightStatementLastValue}"/>
                        </Grid>
                        <Button Content="Lưu" Command="{Binding SaveParametersCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" IsEnabled="{Binding CanUpdate}"/>
                        <Border Style="{StaticResource StatusBanner}" Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}">
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrushBlack}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <ScrollViewer Margin="16" Visibility="{Binding IsCompanySelected, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource EditorCard}" MaxWidth="520" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Thông tin công ty" Style="{StaticResource WorkspaceTitle}" Margin="0,0,0,16"/>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Tên"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding CompanyName}"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Địa chỉ"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding CompanyAddress}"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Điện thoại"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding CompanyPhone}"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Mã số thuế"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding CompanyTaxCode}"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Ngân hàng"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding CompanyBank}"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Website"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding CompanyWebsite}"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Email"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding CompanyEmail}"/>
                        </Grid>
                        <Button Content="Lưu" Command="{Binding SaveCompanyCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" IsEnabled="{Binding CanUpdate}"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <Grid Visibility="{Binding IsLocationAliasesSelected, Converter={StaticResource BoolToVisibility}}">
                <views:LocationAliasView DataContext="{Binding LocationAliases}"/>
            </Grid>
            <Grid Visibility="{Binding IsRouteAliasesSelected, Converter={StaticResource BoolToVisibility}}">
                <views:RouteAliasView DataContext="{Binding RouteAliases}"/>
            </Grid>
            <Grid Visibility="{Binding IsCustomerAliasesSelected, Converter={StaticResource BoolToVisibility}}">
                <views:CustomerAliasView DataContext="{Binding CustomerAliases}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
