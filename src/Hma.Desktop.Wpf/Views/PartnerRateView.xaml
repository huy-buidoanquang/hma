<UserControl x:Class="Hma.Desktop.Wpf.Views.PartnerRateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Hma.Desktop.Wpf.Behaviors"
             xmlns:controls="clr-namespace:Hma.Desktop.Wpf.Controls">
    <Grid>
        <DockPanel Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibility}}" Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Giá mua đối tác" Style="{StaticResource WorkspaceTitle}" Margin="0,0,0,16"/>
            <WrapPanel DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
                <Button Content="Làm mới" Command="{Binding SearchCommand}"/>
                <Button Content="Thêm mới" Command="{Binding NewItemCommand}" IsEnabled="{Binding CanCreate}"/>
            </WrapPanel>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" b:CommandBehaviors.DoubleClickCommand="{Binding ViewItemCommand}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Đối tác" Binding="{Binding Partner.Name}" Width="180"/>
                    <DataGridTextColumn Header="Tuyến" Binding="{Binding Route.Name}" Width="*"/>
                    <DataGridTextColumn Header="Loại xe" Binding="{Binding VehicleType.Name}" Width="120"/>
                    <DataGridTextColumn Header="Từ ngày" Binding="{Binding EffectiveFrom, StringFormat=dd/MM/yyyy}" Width="95"/>
                    <DataGridTextColumn Header="Đến ngày" Binding="{Binding EffectiveTo, StringFormat=dd/MM/yyyy}" Width="95"/>
                    <DataGridTextColumn Header="Giá mua" Binding="{Binding UnitPrice, Converter={StaticResource VndMoney}}" Width="120" ElementStyle="{StaticResource TabularMoneyCell}"/>
                    <DataGridTextColumn Header="Phụ phí" Binding="{Binding Surcharge, Converter={StaticResource VndMoney}}" Width="110" ElementStyle="{StaticResource TabularMoneyCell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <controls:EditorOverlay Visibility="{Binding IsBrowsing, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <StackPanel IsEnabled="{Binding AreFieldsEnabled}">
                    <Label Content="Đối tác"/><ComboBox ItemsSource="{Binding Partners}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Editor.PartnerId}"/>
                    <Label Content="Tuyến"/><ComboBox ItemsSource="{Binding Routes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Editor.RouteId}"/>
                    <Label Content="Loại xe"/><ComboBox ItemsSource="{Binding VehicleTypes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Editor.VehicleTypeId}"/>
                    <WrapPanel>
                        <StackPanel Width="180" Margin="0,0,8,0"><Label Content="Hiệu lực từ"/><DatePicker SelectedDate="{Binding Editor.EffectiveFrom}"/></StackPanel>
                        <StackPanel Width="180"><Label Content="Hiệu lực đến"/><DatePicker SelectedDate="{Binding Editor.EffectiveTo}"/></StackPanel>
                    </WrapPanel>
                    <Label Content="Giá mua"/><TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.UnitPrice, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money"/>
                    <Label Content="Phụ phí mua"/><TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.Surcharge, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money"/>
                </StackPanel>
                <StackPanel Style="{StaticResource EditorActions}">
                    <Button Content="Lưu" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"/>
                    <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
                    <Button Content="Xóa" Style="{StaticResource DestructiveButton}" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </StackPanel>
        </controls:EditorOverlay>
    </Grid>
</UserControl>
