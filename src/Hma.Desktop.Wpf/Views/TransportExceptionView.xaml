<UserControl x:Class="Hma.Desktop.Wpf.Views.TransportExceptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Hma.Desktop.Wpf.Behaviors">
    <Grid>
        <DockPanel Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibility}}" Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Sự cố vận tải" Style="{StaticResource WorkspaceTitle}" Margin="0,0,0,16"/>
            <WrapPanel DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
                <Button Content="Thêm sự cố" Command="{Binding NewItemCommand}" IsEnabled="{Binding CanCreate}"/>
            </WrapPanel>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                      b:CommandBehaviors.DoubleClickCommand="{Binding ViewItemCommand}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ngày" Binding="{Binding OccurredAt, StringFormat=dd/MM/yyyy HH:mm}" Width="125"/>
                    <DataGridTextColumn Header="Lệnh" Binding="{Binding DispatchOrder.Code}" Width="90"/>
                    <DataGridTextColumn Header="Mã" Binding="{Binding CodeSnapshot}" Width="95"/>
                    <DataGridTextColumn Header="Sự cố" Binding="{Binding NameSnapshot}" Width="170"/>
                    <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Thu KH" Binding="{Binding CustomerCharge, Converter={StaticResource VndMoney}}" Width="105" ElementStyle="{StaticResource TabularMoneyCell}"/>
                    <DataGridTextColumn Header="Chi ĐT" Binding="{Binding PartnerCost, Converter={StaticResource VndMoney}}" Width="105" ElementStyle="{StaticResource TabularMoneyCell}"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="{Binding EditorTitle}" Style="{StaticResource WorkspaceTitle}" Margin="0,0,0,16"/>
            <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource EditorActions}">
                <Button Content="Lưu" Command="{Binding SaveCommand}" IsEnabled="{Binding CanPersist}"/>
                <Button Content="Gửi duyệt" Style="{StaticResource SecondaryButton}" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}"/>
                <Button Content="Xóa bản nháp" Style="{StaticResource DestructiveButton}" Command="{Binding DeleteDraftCommand}" IsEnabled="{Binding CanDeleteDraft}"/>
                <Button Content="Duyệt" Style="{StaticResource SecondaryButton}" Command="{Binding ApproveCommand}" IsEnabled="{Binding CanApprove}"/>
                <Button Content="Từ chối" Style="{StaticResource SecondaryButton}" Command="{Binding RejectCommand}" IsEnabled="{Binding CanReject}"/>
                <Button Content="Hủy đã duyệt" Style="{StaticResource DestructiveButton}" Command="{Binding VoidCommand}" IsEnabled="{Binding CanVoid}"/>
                <Button Content="Đóng" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
            </StackPanel>
            <ScrollViewer b:ScrollViewerBehaviors.FormScroll="True" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource EditorCard}">
                    <StackPanel>
                        <WrapPanel IsEnabled="{Binding AreFieldsEnabled}">
                            <StackPanel Width="220" Margin="0,0,12,8">
                                <Label Content="Lệnh điều xe"/>
                                <ComboBox ItemsSource="{Binding Orders}" DisplayMemberPath="Code" SelectedValuePath="Id"
                                          SelectedValue="{Binding Editor.DispatchOrderId}"
                                          Visibility="{Binding IsNewException, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBox Text="{Binding Editor.DispatchOrder.Code, Mode=OneWay}" IsReadOnly="True"
                                         Visibility="{Binding IsExistingException, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                            <StackPanel Width="240" Margin="0,0,12,8">
                                <Label Content="Mã sự cố"/>
                                <ComboBox ItemsSource="{Binding Codes}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding Editor.TransportExceptionCodeId}"/>
                            </StackPanel>
                            <StackPanel Width="170" Margin="0,0,12,8">
                                <Label Content="Thời điểm"/>
                                <DatePicker SelectedDate="{Binding Editor.OccurredAt}"/>
                            </StackPanel>
                        </WrapPanel>
                        <Label Content="Mô tả"/>
                        <TextBox Text="{Binding Editor.Description}" AcceptsReturn="True" MinHeight="80" IsReadOnly="{Binding IsEditorReadOnly}"/>
                        <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding AreFieldsEnabled}">
                            <StackPanel Width="200" Margin="0,0,12,8">
                                <Label Content="Khoản thu khách hàng"/>
                                <TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.CustomerCharge, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money"/>
                            </StackPanel>
                            <StackPanel Width="200" Margin="0,0,12,8">
                                <Label Content="Chi phí đối tác"/>
                                <TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.PartnerCost, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money"/>
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,8">
                                <Label Content="Trạng thái"/>
                                <TextBox Text="{Binding Editor.StatusLabel, Mode=OneWay}" IsReadOnly="True"/>
                            </StackPanel>
                        </WrapPanel>
                        <Label Content="Lý do từ chối / hủy"/>
                        <TextBox Text="{Binding ActionReason}" AcceptsReturn="True" MinHeight="65"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
