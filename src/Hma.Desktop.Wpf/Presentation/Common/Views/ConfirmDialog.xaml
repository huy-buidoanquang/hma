<Window x:Class="Hma.Desktop.Wpf.Presentation.Common.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MinWidth="420"
        MaxWidth="520"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        Foreground="{DynamicResource InkBrush}">
    <Border Margin="16" Style="{StaticResource EditorCard}" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.28"/>
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource BrushDeep}" Padding="20,14"
                    CornerRadius="6,6,0,0">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushOnBrand}"/>
            </Border>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,0,12,16">
                <Button Content="{Binding CancelText}" Style="{StaticResource SecondaryButton}"
                        IsCancel="True" Click="OnCancel" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmButton" Content="{Binding ConfirmText}"
                        IsDefault="True" Click="OnConfirm" Margin="0"/>
            </StackPanel>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="20,20,20,16"
                       Style="{StaticResource BodyText}" LineHeight="22"/>
        </DockPanel>
    </Border>
</Window>
