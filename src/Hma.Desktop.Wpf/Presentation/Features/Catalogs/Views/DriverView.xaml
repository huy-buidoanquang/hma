<UserControl x:Class="Hma.Desktop.Wpf.Presentation.Features.Catalogs.Views.DriverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Hma.Desktop.Wpf.Behaviors">
    <Grid>
        <DockPanel Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibility}}" Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Tài xế" Style="{StaticResource WorkspaceTitle}" Margin="0,0,0,16"/>
            <StackPanel DockPanel.Dock="Top">
                <WrapPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Mã"/>
                        <TextBox Style="{StaticResource SearchField}" Width="112" Text="{Binding FilterCode}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Tên"/>
                        <TextBox Style="{StaticResource SearchField}" Width="200" Text="{Binding FilterName}"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel Style="{StaticResource ActionBar}">
                    <Button Content="Tìm" Command="{Binding SearchCommand}"/>
                    <Button Content="Làm lại" Style="{StaticResource SecondaryButton}" Command="{Binding ResetFiltersCommand}"/>
                    <Border Style="{StaticResource ToolbarSpacer}"/>
                    <Button Content="Thêm mới" Command="{Binding NewItemCommand}" IsEnabled="{Binding CanCreate}"/>
                    <Button Content="Excel" Style="{StaticResource SecondaryButton}" Command="{Binding ExportExcelCommand}" IsEnabled="{Binding CanPrint}"/>
                </WrapPanel>
            </StackPanel>
            <Border Style="{StaticResource StatusBanner}" DockPanel.Dock="Bottom"
                    Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrushBlack}"/>
            </Border>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                      b:CommandBehaviors.DoubleClickCommand="{Binding ViewItemCommand}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="80"/>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Ngày sinh" Binding="{Binding BirthDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="ĐT" Binding="{Binding Phone}" Width="110"/>
                    <DataGridTextColumn Header="CCCD" Binding="{Binding IdentityNumber}" Width="130"/>
                    <DataGridTextColumn Header="Đối tác" Binding="{Binding Partner.Name}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="{Binding EditorTitle}" Style="{StaticResource WorkspaceTitle}" Margin="0,0,0,16"/>
            <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource EditorActions}">
                <Button Content="Lưu" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"/>
                <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
                <Button Content="Xóa" Style="{StaticResource DestructiveButton}" Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding CanDelete}" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <Border Style="{StaticResource EditorCard}" IsEnabled="{Binding AreFieldsEnabled}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Mã"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding Editor.Code, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Required"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Họ tên"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Required"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Ngày sinh"/>
                            <DatePicker Grid.Column="1" Margin="0" SelectedDate="{Binding Editor.BirthDate}"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Điện thoại"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding Editor.Phone, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Phone"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Số CCCD"/>
                            <TextBox Grid.Column="1" Margin="0" Text="{Binding Editor.IdentityNumber}"/>
                        </Grid>
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Style="{StaticResource FormLabel}" Content="Đối tác"/>
                            <ComboBox Grid.Column="1" Margin="0" ItemsSource="{Binding Partners}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Editor.PartnerId}"/>
                        </Grid>
                        <TextBlock Text="Lịch sử chuyến" Style="{StaticResource SectionTitle}" Margin="0,8,0,8"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Trips}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding PickupAt, StringFormat=dd/MM/yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="Khách" Binding="{Binding Customer.Name}" Width="*"/>
                            <DataGridTextColumn Header="Tuyến" Binding="{Binding RouteLabel}" Width="140"/>
                            <DataGridTextColumn Header="Biển" Binding="{Binding Vehicle.PlateNumber}" Width="100" ElementStyle="{StaticResource TabularCell}"/>
                            <DataGridTextColumn Header="Cước" Binding="{Binding TotalAmount, Converter={StaticResource VndMoney}}" Width="90" ElementStyle="{StaticResource TabularMoneyCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
