<UserControl x:Class="Hma.Desktop.Wpf.Presentation.Features.Dispatching.Views.DispatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Hma.Desktop.Wpf.Behaviors"
             xmlns:controls="clr-namespace:Hma.Desktop.Wpf.Controls">
    <Grid>
        <DockPanel Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibility}}" Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Lệnh điều xe" Style="{StaticResource WorkspaceTitle}" Margin="0,0,0,16"/>
            <StackPanel DockPanel.Dock="Top">
                <WrapPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Số LDX"/>
                        <TextBox Style="{StaticResource SearchField}" Width="112" Text="{Binding FilterCode}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Mã KH"/>
                        <TextBox Style="{StaticResource SearchField}" Width="100" Text="{Binding FilterCustomerCode}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Từ ngày"/>
                        <DatePicker Style="{StaticResource FilterDate}" SelectedDate="{Binding FilterFrom}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Đến ngày"/>
                        <DatePicker Style="{StaticResource FilterDate}" SelectedDate="{Binding FilterTo}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Khách hàng"/>
                        <ComboBox Style="{StaticResource FilterCombo}" Width="200" ItemsSource="{Binding CustomerOptions}" DisplayMemberPath="CodeName" SelectedValuePath="Id" SelectedValue="{Binding FilterCustomerId}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Biển số"/>
                        <TextBox Style="{StaticResource SearchField}" Width="112" Text="{Binding FilterPlate}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Điểm đi"/>
                        <ComboBox Style="{StaticResource FilterCombo}" Width="140" ItemsSource="{Binding Locations}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FilterPickupLocationId}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Điểm đến"/>
                        <ComboBox Style="{StaticResource FilterCombo}" Width="140" ItemsSource="{Binding Locations}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FilterDeliveryLocationId}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Trọng tải"/>
                        <TextBox Style="{StaticResource SearchField}" Width="80" Text="{Binding FilterTonnage, TargetNullValue=''}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Loại xe"/>
                        <ComboBox Style="{StaticResource FilterCombo}" Width="140" ItemsSource="{Binding VehicleTypes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FilterVehicleTypeId}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Trạng thái"/>
                        <ComboBox Style="{StaticResource FilterCombo}" Width="140" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding FilterStatus}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FilterCluster}">
                        <Label Style="{StaticResource FilterLabel}" Content="Đối soát"/>
                        <ComboBox Style="{StaticResource FilterCombo}" Width="160" ItemsSource="{Binding ReconOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding FilterRecon}"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel Style="{StaticResource ActionBar}">
                    <Button Content="Tìm" Command="{Binding SearchCommand}"/>
                    <Button Content="Làm lại" Style="{StaticResource SecondaryButton}" Command="{Binding ResetFiltersCommand}"/>
                    <Border Style="{StaticResource ToolbarSpacer}"/>
                    <Button Content="Thêm mới" Command="{Binding NewItemCommand}" IsEnabled="{Binding CanCreate}"/>
                    <Button Content="Excel cước" Style="{StaticResource SecondaryButton}" Command="{Binding ExportExcelCommand}" IsEnabled="{Binding CanPrint}"/>
                    <Button Content="In ngày" Style="{StaticResource SecondaryButton}" Command="{Binding PrintSummaryDayCommand}" IsEnabled="{Binding CanPrint}"/>
                    <Button Content="In tháng" Style="{StaticResource SecondaryButton}" Command="{Binding PrintSummaryMonthCommand}" IsEnabled="{Binding CanPrint}"/>
                    <Button Content="In theo khách" Style="{StaticResource SecondaryButton}" Command="{Binding PrintSummaryCustomerCommand}" IsEnabled="{Binding CanPrint}"/>
                </WrapPanel>
            </StackPanel>
            <Border Style="{StaticResource StatusBanner}" DockPanel.Dock="Bottom"
                    Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrushBlack}"/>
            </Border>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      b:CommandBehaviors.DoubleClickCommand="{Binding ViewItemCommand}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ngày chạy" Binding="{Binding PickupAt, StringFormat=dd/MM/yyyy}" Width="100" ElementStyle="{StaticResource DataGridSingleLineCell}"/>
                    <DataGridTextColumn Header="Số LDX" Binding="{Binding Code}" Width="100" ElementStyle="{StaticResource DataGridCodeCell}"/>
                    <DataGridTemplateColumn Header="Trạng thái" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:StatusBadge OrderStatus="{Binding Status}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Đối soát" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:StatusBadge ReconStatus="{Binding ReconciliationStatus}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Mã KH" Binding="{Binding Customer.Code}" Width="95" ElementStyle="{StaticResource DataGridCodeCell}"/>
                    <DataGridTextColumn Header="Tuyến" Binding="{Binding RouteLabel}" Width="180" ElementStyle="{StaticResource DataGridSingleLineCell}"/>
                    <DataGridTextColumn Header="Biển" Binding="{Binding Vehicle.PlateNumber}" Width="100" ElementStyle="{StaticResource TabularSingleLineCell}"/>
                    <DataGridTextColumn Header="Tải" Binding="{Binding VehicleType.Name}" Width="115" ElementStyle="{StaticResource DataGridSingleLineCell}"/>
                    <DataGridTextColumn Header="Cước" Binding="{Binding UnitPrice, Converter={StaticResource VndMoney}}" Width="110" ElementStyle="{StaticResource TabularMoneySingleLineCell}"/>
                    <DataGridTextColumn Header="Phát sinh" Binding="{Binding BillableExtraCost, Converter={StaticResource VndMoney}}" Width="110" ElementStyle="{StaticResource TabularMoneySingleLineCell}"/>
                    <DataGridTextColumn Header="TT" Binding="{Binding PaymentMethod.Name}" Width="110" ElementStyle="{StaticResource DataGridSingleLineCell}"/>
                    <DataGridTextColumn Header="Kỳ KT" Binding="{Binding BillingMonth, StringFormat={}{0:00}}" Width="70" ElementStyle="{StaticResource TabularSingleLineCell}"/>
                    <DataGridTextColumn Header="Khách" Binding="{Binding Customer.Name}" Width="240" ElementStyle="{StaticResource DataGridSingleLineCell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" Margin="16">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16" LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border CornerRadius="10" Padding="8,2" Margin="0,1,8,1"
                            Background="{DynamicResource SuccessBgBrush}"
                            Visibility="{Binding FreightMatched, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding MatchedPriceListCode, StringFormat='Bảng giá {0}'}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>
                    <controls:StatusBadge OrderStatus="{Binding Editor.Status}" Margin="0,0,8,0"/>
                    <controls:StatusBadge ReconStatus="{Binding Editor.ReconciliationStatus}"/>
                </StackPanel>
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource WorkspaceTitle}"/>
            </DockPanel>
            <WrapPanel DockPanel.Dock="Bottom" Style="{StaticResource ToolbarPanel}">
                <Button Content="Tính cước" Style="{StaticResource SecondaryButton}" Command="{Binding CalcFreightCommand}" IsEnabled="{Binding AreFieldsEnabled}"/>
                <Button Content="Lưu" Command="{Binding SaveCommand}" IsEnabled="{Binding CanPersist}"/>
                <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
                <Button Content="Hoàn thành" Style="{StaticResource SecondaryButton}" Command="{Binding CompleteCommand}" IsEnabled="{Binding CanComplete}"/>
                <Button Content="Chốt lệnh" Style="{StaticResource SecondaryButton}" Command="{Binding LockCommand}" IsEnabled="{Binding CanLock}"/>
                <Button Content="Bỏ chốt" Style="{StaticResource SecondaryButton}" Command="{Binding UnlockCommand}" IsEnabled="{Binding CanUnlock}"/>
                <Button Content="In lệnh" Style="{StaticResource SecondaryButton}" Command="{Binding PrintCommand}" IsEnabled="{Binding CanPrint}"/>
                <Button Content="Xóa" Style="{StaticResource DestructiveButton}" Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding CanDelete}" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}"/>
            </WrapPanel>
            <Border Style="{StaticResource StatusBanner}" DockPanel.Dock="Bottom"
                    Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrushBlack}"/>
            </Border>
            <ScrollViewer b:ScrollViewerBehaviors.FormScroll="True" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource EditorCard}">
                    <TabControl>
                        <TabItem Header="Thông tin chuyến" HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
                            <StackPanel Margin="16">
                                <WrapPanel>
                                    <StackPanel Width="100" Margin="0,0,8,8">
                                        <Label Content="Số lệnh"/>
                                        <TextBox Text="{Binding CodeLabel, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Width="180" Margin="0,0,8,8">
                                        <Label Content="Ngày chạy"/>
                                        <DatePicker SelectedDate="{Binding PickupDate}" IsEnabled="{Binding AreFieldsEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Width="60" Margin="0,0,8,8">
                                        <Label Content="Giờ"/>
                                        <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding PickupHour}" IsEnabled="{Binding AreFieldsEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Width="60" Margin="0,0,8,8">
                                        <Label Content="Phút"/>
                                        <ComboBox ItemsSource="{Binding Minutes}" SelectedItem="{Binding PickupMinute}" IsEnabled="{Binding AreFieldsEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,8,8">
                                        <Label Content="Khách hàng tính cước"/>
                                        <ComboBox ItemsSource="{Binding CustomerOptions}" DisplayMemberPath="CodeName" SelectedValuePath="Id" SelectedValue="{Binding EditorCustomerId}" IsEnabled="{Binding AreFieldsEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,8,8">
                                        <Label Content="Tuyến"/>
                                        <ComboBox ItemsSource="{Binding Routes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EditorRouteId}" IsEnabled="{Binding AreFieldsEnabled}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel>
                                    <StackPanel Width="250" Margin="0,0,8,8">
                                        <Label Content="Biển kiểm soát"/>
                                        <ComboBox ItemsSource="{Binding Vehicles}" DisplayMemberPath="PlateNumber"
                                                  SelectedValuePath="Id" SelectedValue="{Binding EditorVehicleId, Mode=TwoWay}"
                                                  Text="{Binding VehicleLookupText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True" IsTextSearchEnabled="False"
                                                  b:AutoCompleteComboBoxBehavior.IsEnabled="True"
                                                  IsEnabled="{Binding AreFieldsEnabled}"
                                                  ToolTip="Gõ biển số để lọc và chọn xe"/>
                                    </StackPanel>
                                    <StackPanel Width="110" Margin="0,0,8,8">
                                        <Label Content="Trọng tải"/>
                                        <TextBox Text="{Binding TonnageLabel, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Width="300" Margin="0,0,8,8">
                                        <Label Content="Tài xế"/>
                                        <ComboBox ItemsSource="{Binding Drivers}" DisplayMemberPath="Name"
                                                  SelectedValuePath="Id" SelectedValue="{Binding EditorDriverId, Mode=TwoWay}"
                                                  Text="{Binding DriverLookupText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True" IsTextSearchEnabled="False"
                                                  b:AutoCompleteComboBoxBehavior.IsEnabled="True"
                                                  IsEnabled="{Binding AreFieldsEnabled}"
                                                  ToolTip="Gõ mã hoặc tên để lọc và chọn tài xế"/>
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,8,8">
                                        <Label Content="SĐT tài xế"/>
                                        <TextBox Text="{Binding DriverPhone, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Width="180" Margin="0,0,8,8">
                                        <Label Content="Hình thức thanh toán"/>
                                        <ComboBox ItemsSource="{Binding PaymentMethods}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EditorPaymentMethodId}" IsEnabled="{Binding AreFieldsEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Width="160" Margin="0,0,8,8">
                                        <Label Content="Kỳ kế toán"/>
                                        <controls:MonthYearPicker Month="{Binding Editor.BillingMonth}" Year="{Binding Editor.BillingYear}" IsEnabled="{Binding AreFieldsEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,8,8">
                                        <Label Content="Số AR"/>
                                        <TextBox Text="{Binding Editor.ArNumber}" IsReadOnly="{Binding IsEditorReadOnly}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="Người gửi và người nhận" Style="{StaticResource SectionTitle}" Margin="0,8,0,8"/>
                                <WrapPanel>
                                    <StackPanel Width="320" Margin="0,0,12,8">
                                        <Label Content="Người gửi"/>
                                        <ComboBox ItemsSource="{Binding CustomerOptions}" DisplayMemberPath="CodeName" SelectedValuePath="Id" SelectedValue="{Binding EditorSenderId}" IsEnabled="{Binding AreFieldsEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Width="240" Margin="0,0,12,8">
                                        <Label Content="Tên người gửi (snapshot)"/>
                                        <TextBox Text="{Binding Editor.SenderName}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,12,8">
                                        <Label Content="SĐT người gửi"/>
                                        <TextBox Text="{Binding Editor.SenderPhone}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Width="320" Margin="0,0,12,8">
                                        <Label Content="Địa chỉ lấy hàng"/>
                                        <TextBox Text="{Binding Editor.PickupAddress}" IsReadOnly="{Binding IsEditorReadOnly}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel>
                                    <StackPanel Width="320" Margin="0,0,12,8">
                                        <Label Content="Người nhận"/>
                                        <ComboBox ItemsSource="{Binding CustomerOptions}" DisplayMemberPath="CodeName" SelectedValuePath="Id" SelectedValue="{Binding EditorReceiverId}" IsEnabled="{Binding AreFieldsEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Width="240" Margin="0,0,12,8">
                                        <Label Content="Tên người nhận (snapshot)"/>
                                        <TextBox Text="{Binding Editor.ReceiverName}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,12,8">
                                        <Label Content="SĐT người nhận"/>
                                        <TextBox Text="{Binding Editor.ReceiverPhone}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Width="320" Margin="0,0,12,8">
                                        <Label Content="Địa chỉ giao hàng"/>
                                        <TextBox Text="{Binding Editor.DeliveryAddress}" IsReadOnly="{Binding IsEditorReadOnly}"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </TabItem>
                        <TabItem HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Cước phí"/>
                                    <TextBlock Text="✓" Margin="6,0,0,0" FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               ToolTip="Đã khớp bảng giá"
                                               Visibility="{Binding FreightMatched, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="⚠" Margin="6,0,0,0" FontWeight="Bold"
                                               FontFamily="Segoe UI Symbol"
                                               Foreground="{DynamicResource WarningBrush}"
                                               ToolTip="Chưa khớp bảng giá"
                                               Visibility="{Binding FreightMissing, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </TabItem.Header>
                            <StackPanel Margin="16">
                                <WrapPanel>
                                    <StackPanel Width="168" Margin="0,0,12,8">
                                        <Label Content="Cước"/>
                                        <TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.UnitPrice, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money" IsReadOnly="{Binding IsFreightReadOnly}"/>
                                    </StackPanel>
                                    <StackPanel Width="168" Margin="0,0,12,8">
                                        <Label Content="Phụ phí"/>
                                        <TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.Surcharge, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money" IsReadOnly="{Binding IsFreightReadOnly}"/>
                                    </StackPanel>
                                    <StackPanel Width="168" Margin="0,0,12,8">
                                        <Label Content="Phát sinh"/>
                                        <TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.ExtraCost, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money" IsReadOnly="{Binding IsFreightReadOnly}"/>
                                    </StackPanel>
                                    <StackPanel Width="168" Margin="0,0,12,8">
                                        <Label Content="Tổng"/>
                                        <TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.TotalAmount, Converter={StaticResource VndMoney}, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="{Binding FreightSourceLabel}" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource InkSecondaryBrush}"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <StackPanel Width="168" Margin="0,0,12,8">
                                        <Label Content="Sự cố đã duyệt thu KH"/>
                                        <TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.ApprovedExceptionRevenue, Converter={StaticResource VndMoney}, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Width="168" Margin="0,0,12,8">
                                        <Label Content="Sự cố đã duyệt chi ĐT"/>
                                        <TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.ApprovedExceptionCost, Converter={StaticResource VndMoney}, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="Chưa khớp bảng giá — nhập cước thủ công hoặc bổ sung dòng giá (tuyến × loại xe)." TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource BrushError}" Visibility="{Binding FreightMissing, Converter={StaticResource BoolToVisibility}}"/>
                                <Label Content="Lý do cước thủ công / khác bảng giá"/>
                                <TextBox Text="{Binding Editor.FreightOverrideReason}" IsReadOnly="{Binding IsFreightReadOnly}" Margin="0,0,0,8"/>
                                <TextBlock Text="Giá mua và biên lợi nhuận" Style="{StaticResource SectionTitle}" Margin="0,12,0,8"/>
                                <WrapPanel>
                                    <StackPanel Width="220" Margin="0,0,12,8">
                                        <Label Content="Đối tác vận tải"/>
                                        <TextBox Text="{Binding Editor.PartnerNameSnapshot}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Width="168" Margin="0,0,12,8">
                                        <Label Content="Giá mua"/>
                                        <TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.BuyUnitPrice, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money" IsReadOnly="{Binding IsFreightReadOnly}"/>
                                    </StackPanel>
                                    <StackPanel Width="168" Margin="0,0,12,8">
                                        <Label Content="Phụ phí mua"/>
                                        <TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.BuySurcharge, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money" IsReadOnly="{Binding IsFreightReadOnly}"/>
                                    </StackPanel>
                                    <StackPanel Width="168" Margin="0,0,12,8">
                                        <Label Content="Phát sinh mua"/>
                                        <TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.BuyExtraCost, Converter={StaticResource VndMoney}, UpdateSourceTrigger=PropertyChanged}" b:InputValidation.Rule="Money" IsReadOnly="{Binding IsFreightReadOnly}"/>
                                    </StackPanel>
                                    <StackPanel Width="130" Margin="0,0,12,8">
                                        <Label Content="Phí điều hành %"/>
                                        <TextBox Text="{Binding Editor.PartnerOperatingFeePercent}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Width="168" Margin="0,0,12,8">
                                        <Label Content="Phải trả đối tác"/>
                                        <TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.PartnerPayableAmount, Converter={StaticResource VndMoney}, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Width="168" Margin="0,0,12,8">
                                        <Label Content="Lãi gộp"/>
                                        <TextBox Style="{StaticResource MoneyField}" Text="{Binding Editor.GrossMargin, Converter={StaticResource VndMoney}, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="{Binding Editor.BuyRateSourceSnapshot}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource InkSecondaryBrush}"/>
                                <Label Content="Lý do giá mua thủ công / khác bảng giá"/>
                                <TextBox Text="{Binding Editor.BuyOverrideReason}" IsReadOnly="{Binding IsFreightReadOnly}" Margin="0,0,0,8"/>
                                <Label Content="Ghi chú"/>
                                <TextBox Text="{Binding Editor.Notes}" AcceptsReturn="True" MinHeight="90" IsReadOnly="{Binding IsEditorReadOnly}"/>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Hàng hóa" HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
                            <DockPanel Margin="16">
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button Content="Thêm dòng" Command="{Binding AddLineCommand}" IsEnabled="{Binding AreFieldsEnabled}"/>
                                    <Button Content="Bỏ dòng" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveLineCommand}" CommandParameter="{Binding SelectedLine}" IsEnabled="{Binding AreFieldsEnabled}"/>
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding LineItems}" SelectedItem="{Binding SelectedLine}" MinHeight="260"
                                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="{Binding IsEditorReadOnly}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STT" Binding="{Binding LineNumber}" Width="55" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Tên hàng" Binding="{Binding GoodsName}" MinWidth="180" Width="*"/>
                                        <DataGridTextColumn Header="Số kiện" Binding="{Binding PackageCount}" Width="90"/>
                                        <DataGridTextColumn Header="Cung đường" Binding="{Binding Route}" Width="180"/>
                                        <DataGridTextColumn Header="Km" Binding="{Binding Kilometers}" Width="90"/>
                                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes}" MinWidth="160" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Chứng từ" HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
                            <DockPanel Margin="16">
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <ComboBox Margin="0,0,8,8" Width="220" ItemsSource="{Binding DocKindOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SelectedDocKind}" IsEnabled="{Binding CanAttachDocument}"/>
                                    <Button Content="Đính kèm" Command="{Binding AttachCommand}" IsEnabled="{Binding CanAttachDocument}"/>
                                    <Button Content="Mở file" Style="{StaticResource SecondaryButton}" Command="{Binding OpenDocumentCommand}" IsEnabled="{Binding CanOpenDocument}"/>
                                    <Button Content="Xóa file" Style="{StaticResource DestructiveButton}" Command="{Binding DeleteDocumentCommand}" IsEnabled="{Binding CanDeleteDocument}"/>
                                </WrapPanel>
                                <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Text="Biên bản giao hàng là bắt buộc trước khi gửi đối soát." Foreground="{DynamicResource InkSecondaryBrush}"/>
                                <DataGrid ItemsSource="{Binding DocumentItems}" SelectedItem="{Binding SelectedDocument}" MinHeight="240" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Loại" Binding="{Binding Kind, Converter={StaticResource BusinessEnumLabel}}" Width="150"/>
                                        <DataGridTextColumn Header="Tên file" Binding="{Binding FileName}" MinWidth="220" Width="*"/>
                                        <DataGridTextColumn Header="Tải lên lúc" Binding="{Binding UploadedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                                        <DataGridTextColumn Header="Người tải" Binding="{Binding UploadedByUser.DisplayName}" Width="160"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Border>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
