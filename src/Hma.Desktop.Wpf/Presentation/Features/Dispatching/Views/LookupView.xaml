<UserControl x:Class="Hma.Desktop.Wpf.Presentation.Features.Dispatching.Views.LookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Hma.Desktop.Wpf.Behaviors"
             xmlns:controls="clr-namespace:Hma.Desktop.Wpf.Controls">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Tra cứu chuyến" Style="{StaticResource WorkspaceTitle}" Margin="0,0,0,16"/>
        <StackPanel DockPanel.Dock="Top">
            <WrapPanel>
                <StackPanel Style="{StaticResource FilterCluster}">
                    <Label Style="{StaticResource FilterLabel}" Content="Số LDX hoặc biển số"/>
                    <TextBox Style="{StaticResource SearchField}" Width="240" Text="{Binding Query}"/>
                </StackPanel>
            </WrapPanel>
            <WrapPanel Style="{StaticResource ActionBar}">
                <Button Content="Tìm" Command="{Binding SearchCommand}"/>
            </WrapPanel>
        </StackPanel>
        <Border Style="{StaticResource StatusBanner}" DockPanel.Dock="Bottom"
                Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrushBlack}"/>
        </Border>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                  b:CommandBehaviors.DoubleClickCommand="{Binding ViewItemCommand}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ngày" Binding="{Binding PickupAt, StringFormat=dd/MM/yyyy}" Width="90"/>
                <DataGridTextColumn Header="Số LDX" Binding="{Binding Code}" Width="90"/>
                <DataGridTextColumn Header="Khách" Binding="{Binding Customer.Name}" Width="160"/>
                <DataGridTextColumn Header="Tuyến" Binding="{Binding RouteLabel}" Width="*"/>
                <DataGridTextColumn Header="Biển" Binding="{Binding Vehicle.PlateNumber}" Width="100" ElementStyle="{StaticResource TabularCell}"/>
                <DataGridTextColumn Header="Tài xế" Binding="{Binding Driver.Name}" Width="130"/>
                <DataGridTextColumn Header="Tổng" Binding="{Binding TotalAmount, Converter={StaticResource VndMoney}}" Width="100" ElementStyle="{StaticResource TabularMoneyCell}"/>
                <DataGridTemplateColumn Header="Trạng thái" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:StatusBadge OrderStatus="{Binding Status}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Đối soát" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:StatusBadge ReconStatus="{Binding ReconciliationStatus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
