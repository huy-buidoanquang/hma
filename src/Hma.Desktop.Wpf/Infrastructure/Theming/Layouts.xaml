<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WorkspaceRoot" TargetType="Grid">
        <Setter Property="Margin" Value="16"/>
        <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    </Style>

    <Style x:Key="WorkspaceHost" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolbarPanel" TargetType="WrapPanel">
        <Setter Property="Margin" Value="0,16"/>
    </Style>

    <Style x:Key="FilterCluster" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,12,8"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="FilterLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="Padding" Value="0,0,0,4"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="ActionBar" TargetType="WrapPanel">
        <Setter Property="Margin" Value="0,4,0,16"/>
    </Style>

    <Style x:Key="ToolbarSpacer" TargetType="Border">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="EditorCard" TargetType="Border">
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="KpiCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,16,16"/>
        <Setter Property="MinWidth" Value="180"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToastBanner" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,16,16,0"/>
        <Setter Property="MaxWidth" Value="420"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Background" Value="{DynamicResource BrushDeep}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.28"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="EditorActions" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0,16"/>
    </Style>
</ResourceDictionary>
