<Window x:Class="Hma.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Hma.Desktop.Wpf.ViewModels"
        xmlns:views="clr-namespace:Hma.Desktop.Wpf.Views"
        Title="Hà Minh Anh — Điều hành xe"
        Height="768" Width="1366"
        MinHeight="768" MinWidth="1366"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource InkBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardWorkspaceViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomerWorkspaceViewModel}">
            <views:CustomerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PartnerWorkspaceViewModel}">
            <views:PartnerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriverWorkspaceViewModel}">
            <views:DriverView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VehicleWorkspaceViewModel}">
            <views:VehicleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeeWorkspaceViewModel}">
            <views:EmployeeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DepartmentWorkspaceViewModel}">
            <views:DepartmentView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:JobTitleWorkspaceViewModel}">
            <views:JobTitleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CityWorkspaceViewModel}">
            <views:CityView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LocationWorkspaceViewModel}">
            <views:LocationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RouteWorkspaceViewModel}">
            <views:RouteView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RouteCatalogWorkspaceViewModel}">
            <views:RouteCatalogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PriceListWorkspaceViewModel}">
            <views:PriceListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PartnerRateWorkspaceViewModel}">
            <views:PartnerRateView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PartnerSettlementWorkspaceViewModel}">
            <views:PartnerSettlementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DispatchWorkspaceViewModel}">
            <views:DispatchView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DispatchGridEditWorkspaceViewModel}">
            <views:DispatchGridEditView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DispatchHubWorkspaceViewModel}">
            <views:DispatchHubView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReconcileWorkspaceViewModel}">
            <views:ReconcileView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatementWorkspaceViewModel}">
            <views:StatementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LookupWorkspaceViewModel}">
            <views:LookupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportWorkspaceViewModel}">
            <views:ReportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsWorkspaceViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserWorkspaceViewModel}">
            <views:UserView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CashReceiptWorkspaceViewModel}">
            <views:CashReceiptView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CashPaymentWorkspaceViewModel}">
            <views:CashPaymentView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoiceWorkspaceViewModel}">
            <views:InvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransportExceptionWorkspaceViewModel}">
            <views:TransportExceptionView/>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource PaperBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource NavBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,16">
                    <TextBlock Text="HÀ MINH ANH" Style="{StaticResource NavBrandTitle}"/>
                    <TextBlock Text="Điều hành xe" Style="{StaticResource NavBrandSubtitle}"/>
                    <TextBlock Text="{Binding UserLabel}" Style="{StaticResource NavBrandSubtitle}" Margin="0,16,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="Đăng xuất" Style="{StaticResource NavLogoutButton}"
                        Command="{Binding LogoutCommand}"/>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                         Background="Transparent" BorderThickness="0" Margin="8,0,8,16"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NavListBoxItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource NavTextBrush}" FontSize="15"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <ContentControl Grid.Column="1" Style="{StaticResource WorkspaceHost}" Content="{Binding Current}"/>
        <Border Grid.Column="1" Panel.ZIndex="20"
                Visibility="{Binding Current.ToastMessage, Converter={StaticResource StringToVisibility}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ToastBanner}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Current.ToastIsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushError}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Current.ToastMessage}" Foreground="{DynamicResource BrushOnBrand}"
                       TextWrapping="Wrap" FontSize="13"/>
        </Border>
    </Grid>
</Window>
